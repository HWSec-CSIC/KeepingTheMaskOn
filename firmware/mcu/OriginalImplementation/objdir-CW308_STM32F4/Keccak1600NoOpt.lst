 380              	
 381              	@----------------------------------------------------------------------------------
 382              	@-----------------------------------------XOR5 MACRO-------------------------------
 383              	@----------------------------------------------------------------------------------
 384              	@Used in theta step (at the beginning of each macro KeccakRound0, KeccakRound1, 
 385              	@KeccakRound2, KeccakRound3) to compute the parities C(x) of each column (considering
 386              	@a particular half and share). 
 387              	@
 388              	@It receives as inputs:
 389              	@   -i1, i2, i3, i4, i5: memory addresses where 32-bit lanes from the same column, half, and share
 390              	@                        are stored in the INPUT SPACE
 391              	@   -res: register where the parity value will be stored 
 392              	@
 393              	@This macro XORs all i1, i2, i3, i4, i5 inputs and stores the result in the "res" register
 394              	@
 395              	@Equivalent operation: res <-- i1 XOR i2 XOR i3 XOR i4 XOR i5
 396              	@
 397              	@Intermediate registers: r1, r2, r12
 398              	@----------------------------------------------------------------------------------
 399              	
 400              	
 401              	.macro    xor5      res, i1, i2, i3, i4, i5
 402              	    ldr         \res, [r0, #\i1]
 403              	    ldr         r1, [r0, #\i2]
 404              	    ldr         r2, [r0, #\i3]
 405              	    ldr         r12, [r0, #\i4]
 406              	    eors        \res, \res, r1
 407              	    eors        \res, \res, r2
 408              	    eors        \res, \res, r12
 409              	    ldr         r1, [r0, #\i5]
 410              	    eors        \res, \res, r1
 411              	.endm
 412              	
 413              	
 414              	@----------------------------------------------------------------------------------
 415              	@----------------------------------------XORROL MACRO------------------------------
 416              	@----------------------------------------------------------------------------------
 417              	@Used in theta step (at the beginning of each macro KeccakRound0, KeccakRound1, 
 418              	@KeccakRound2, KeccakRound3) to compute the diffusions D(x) of low halfs of the lanes
 419              	@in the OUTPUT space.
 420              	@
 421              	@It receives as inputs:
 422              	@   -aa, bb: registers containing the 32-bit half-lanes that will be XORed
 423              	@   -res: register where the resulting 
 424              	@ 
 425              	@This macro XORs the input "aa" with the input "bb" rotated left by 1 bit,
 426              	@and stores it in the "res" register.
 427              	@
 428              	@Equivalent operation: res <-- aa XOR ROTL(bb, 1)
 429              	@
 430              	@Intermediate registers: None
 431              	@----------------------------------------------------------------------------------
 432              	
 433              	
 434              	
 435              	.macro    xorrol      res, aa, bb
 436              	    eor         \res, \aa, \bb, ROR #31
 437              	.endm
 438              	
 439              	
 440              	@----------------------------------------------------------------------------------
 441              	@----------------------------------------OPCHI MACRO-------------------------------
 442              	@----------------------------------------------------------------------------------
 443              	@Used in the macros KeccakThetaRhoPiChi and KeccakThetaRhoPiChiIota to
 444              	@compute the masked Chi function for one given share.
 445              	@
 446              	@For a given row, it computes the share j of the lane i (Y^i_j) at the output of the 
 447              	@Chi step using the 32-bit half-lanes i, i+1, i+2 of the shares j+1, j+2 (X_{j+1}, X_{j+2})
 448              	@
 449              	@It receives as inputs:
 450              	@   -Ia0, Ia1, Ia2: for a given row, registers containing the 32-bit half-lanes i, i+1, i+2 of the 
 451              	@   -Ib1, Ib2: for a given row, registers containing the 32-bit half-lanes i+1, i+2 of the share j+
 452              	@   -memW: memory address where the resulting Y^i_j will be stored
 453              	@
 454              	@Equivalent operation: Y^i_j <-- f(X_{j+1}, X_{j+2}) = 
 455              	@ =X^{i}_{j+1} XOR X^{i+2}_{j+1} XOR (X^{i+1}_{j+1} & X^{i+2}_{j+1}) XOR (X^{i+1}_{j+1} & X^{i+2}_{
 456              	@
 457              	@Intermediate registers: r1, r2
 458              	@----------------------------------------------------------------------------------
 459              	
 460              	
 461              	
 462              	.macro    OpChi      memW, Ib1, Ib2, Ia0, Ia1, Ia2
 463              	    eors r1, \Ia0, \Ia2
 464              	    and r2, \Ia1, \Ia2
 465              	    eors r1, r1, r2
 466              	    and r2, \Ia1, \Ib2
 467              	    eors r1, r1, r2
 468              	    and r2, \Ib1, \Ia2 
 469              	    eors r1, r1, r2
 470              	    str r1, [r0, \memW]
 471              	.endm
 472              	
 473              	
 474              	@----------------------------------------------------------------------------------
 475              	@----------------------------------KECCAKTHETARHOPICHI MACRO-----------------------
 476              	@----------------------------------------------------------------------------------
 477              	@Used in the macros KeccakRound0, KeccakRound1, KeccakRound2, KeccakRound3 to compute
 478              	@the steps Theta, Rho, Pi Chi.
 479              	@
 480              	@It receives as inputs:
 481              	@   -reg_Aya, reg_Aye, reg_Ayi, reg_Ayo, reg_Ayu: given the diagonal defined for in-place processin
 482              	@   -reg_AyaB, reg_AyeB, reg_AyiB, reg_AyoB, reg_AyuB: given the diagonal defined for in-place proc
 483              	@   -memAya, memAye, memAyi, memAyo, memAyu: given the diagonal defined for in-place processing, me
 484              	@   -Dya, Dye, Dyi, Dyo, Dyu: registers where the diffusion values for each half-lane OF THE SHARE 
 485              	@   -memDya, memDye, memDyi, memDyo, memDyu: memory addresses where the diffusion values for each h
 486              	@   -rotAya, rotAye, rotAyi, rotAyo, rotAyu: rotation values for each half-lane according to rho st
 487              	@
 488              	@Although the group A and group B of registers contains always {r3-r7} and {r8-r12}, respectively, 
 489              	@----------------------------------------------------------------------------------
 490              	
 491              	
 492              	
 493              	.macro    KeccakThetaRhoPiChi reg_Aya, memAya, Dya, rotAya, reg_Aye, memAye, Dye, rotAye, reg_Ayi, 
 494              	    @THETA+RHO APPLIED TO S1
 495              	    push {r2, r8, r9, r10, r11, r12, lr}
 496              	
 497              	
 498              	    @Loading the half-lanes of share 1 into the group A registers
 499              	    ldr     \reg_Aya, [r0, #\memAya]
 500              	    ldr     \reg_Aye, [r0, #\memAye]
 501              	    ldr     \reg_Ayi, [r0, #\memAyi]
 502              	    ldr     \reg_Ayo, [r0, #\memAyo]
 503              	    ldr     \reg_Ayu, [r0, #\memAyu]
 504              	
 505              	    @ Applying diffusion values to the lanes of share 1
 506              	    eors    \reg_Aya, \reg_Aya, \Dya
 507              	    eors    \reg_Aye, \reg_Aye, \Dye
 508              	    eors    \reg_Ayi, \reg_Ayi, \Dyi
 509              	    eors    \reg_Ayo, \reg_Ayo, \Dyo
 510              	    eors    \reg_Ayu, \reg_Ayu, \Dyu
 511              	
 512              	
 513              	    @ Applying rotations of the Rho step to the half-lanes of share 1
 514              	    rors    \reg_Aya, #32-\rotAya
 515              	    .if  \rotAye > 0
 516              	        rors    \reg_Aye, #32-\rotAye
 517              	    .endif
 518              	    rors    \reg_Ayi, #32-\rotAyi
 519              	    rors    \reg_Ayo, #32-\rotAyo
 520              	    rors    \reg_Ayu, #32-\rotAyu
 521              	
 522              	
 523              	    @ Storing half-lanes of the share 1 after applying Theta+Rho
 524              	    str \reg_Aya, [r0, #\memAya]
 525              	    str \reg_Aye, [r0, #\memAye]
 526              	    str \reg_Ayi, [r0, #\memAyi]
 527              	    str \reg_Ayo, [r0, #\memAyo]
 528              	    str \reg_Ayu, [r0, #\memAyu]
 529              	
 530              	
 531              	
 532              	    @THETA+RHO APPLIED TO S2 
 533              	    @Loading the half-lanes of share 2 into the group B registers 
 534              	    @Loading the diffusion values for the half-lanes of share 2 into the auxiliar registers r1, r2,
 535              	    @Applying diffusion values to the half lanes of share 2
 536              	    
 537              	    ldr     \reg_AyaB, [r0, #\memAya+200]
 538              	    ldr     r1, [r0, #\memDya+40]
 539              	    ldr     \reg_AyeB, [r0, #\memAye+200]
 540              	    ldr     r2, [r0, #\memDye+40]
 541              	    ldr     \reg_AyiB, [r0, #\memAyi+200]
 542              	    ldr     lr, [r0, #\memDyi+40]
 543              	
 544              	    eors    \reg_AyaB, \reg_AyaB, r1
 545              	    eors    \reg_AyeB, \reg_AyeB, r2
 546              	    eors    \reg_AyiB, \reg_AyiB, lr
 547              	
 548              	    ldr     \reg_AyoB, [r0, #\memAyo+200]
 549              	    ldr     r1, [r0, #\memDyo+40]
 550              	    ldr     \reg_AyuB, [r0, #\memAyu+200]
 551              	    ldr     lr, [r0, #\memDyu+40]
 552              	    
 553              	    eors    \reg_AyoB, \reg_AyoB, r1
 554              	    eors    \reg_AyuB, \reg_AyuB, lr   
 555              	    
 556              	    @ Applying rotations of the Rho step to the half-lanes of share 2
 557              	    rors    \reg_AyaB, #32-\rotAya
 558              	    .if  \rotAye > 0
 559              	        rors    \reg_AyeB, #32-\rotAye
 560              	    .endif
 561              	    rors    \reg_AyiB, #32-\rotAyi
 562              	    rors    \reg_AyoB, #32-\rotAyo
 563              	    rors    \reg_AyuB, #32-\rotAyu
 564              	
 565              	
 566              	
 567              	    @PI+CHI APPLIED TO SHARE 0 (SHARES 1 - 2). 
 568              	    @At this point, the register values are:
 569              	    @   - r3-r7: half-lanes of the share 1 with Theta and Rho steps applied (Group A)
 570              	    @   - r8-r12: half-lanes of the share 2 with Theta and Rho steps applied (Group B)
 571              	
 572              	    @The following expansions of OpChi macro computes the output share Y_0 from input shares
 573              	    @X_1, X_2 and write them in the corresponding memory address according to in-place processing
 574              	    @(it will be one of the other positions in the diagonal, but not the same)
 575              	    @If we read from memory zone A, we write in the corresponding memory zone B. Else, we have read
 576              	
 577              	    .if     \memAya < 599
 578              	        OpChi   #\memAya+400, r9, r10, r3, r4, r5
 579              	        OpChi   #\memAye+400, r10, r11, r4, r5, r6
 580              	        OpChi   #\memAyi+400, r11, r12, r5, r6, r7
 581              	        OpChi   #\memAyo+400, r12, r8, r6, r7, r3
 582              	        OpChi   #\memAyu+400, r8, r9, r7, r3, r4
 583              	    .else 
 584              	        OpChi   #\memAya-800, r9, r10, r3, r4, r5
 585              	        OpChi   #\memAye-800, r10, r11, r4, r5, r6
 586              	        OpChi   #\memAyi-800, r11, r12, r5, r6, r7
 587              	        OpChi   #\memAyo-800, r12, r8, r6, r7, r3
 588              	        OpChi   #\memAyu-800, r8, r9, r7, r3, r4
 589              	    .endif
 590              	
 591              	
 592              	
 593              	    @THETA+RHO APPLIED TO S0
 594              	
 595              	    @Loading the half-lanes of share 0 into the group A of registers 
 596              	    @Loading the diffusion values for the half-lanes of share 2 into the auxiliar registers r1, r2,
 597              	    @Applying diffusion values to the half lanes of share 2
 598              	
 599              	    ldr     \reg_Aya, [r0, #\memAya-200]
 600              	    ldr     r1, [r0, #\memDya-40]
 601              	    ldr     \reg_Aye, [r0, #\memAye-200]
 602              	    ldr     r2, [r0, #\memDye-40]
 603              	    ldr     \reg_Ayi, [r0, #\memAyi-200]
 604              	    ldr     lr, [r0, #\memDyi-40]
 605              	
 606              	    eors    \reg_Aya, \reg_Aya, r1
 607              	    eors    \reg_Aye, \reg_Aye, r2
 608              	    eors    \reg_Ayi, \reg_Ayi, lr
 609              	
 610              	
 611              	    ldr     \reg_Ayo, [r0, #\memAyo-200]
 612              	    ldr     r1, [r0, #\memDyo-40]
 613              	    ldr     \reg_Ayu, [r0, #\memAyu-200]
 614              	    ldr     lr, [r0, #\memDyu-40]
 615              	    
 616              	    eors    \reg_Ayo, \reg_Ayo, r1
 617              	    eors    \reg_Ayu, \reg_Ayu, lr
 618              	    
 619              	    @ Applying rotations of the Rho step to the half-lanes of share 2
 620              	
 621              	    rors    \reg_Aya, #32-\rotAya
 622              	    .if  \rotAye > 0
 623              	        rors    \reg_Aye, #32-\rotAye
 624              	    .endif
 625              	    rors    \reg_Ayi, #32-\rotAyi
 626              	    rors    \reg_Ayo, #32-\rotAyo
 627              	    rors    \reg_Ayu, #32-\rotAyu
 628              	
 629              	
 630              	
 631              	    @PI+CHI APPLIED TO SHARE 1 (SHARES 2 - 0)
 632              	    @At this point, the register values are:
 633              	    @   - r3-r7: half-lanes of the share 0 with Theta and Rho steps applied (Group A)
 634              	    @   - r8-r12: half-lanes of the share 2 with Theta and Rho steps applied (Group B)
 635              	    @The following expansions of OpChi macro computes the output share Y_1 from input shares
 636              	    @X_2, X_0 and write them in the corresponding memory address according to in-place processing
 637              	    @(it will be one of the other positions in the diagonal, but not the same)
 638              	    @If we read from memory zone A, we write in the corresponding memory zone B. Else, we have read
 639              	    
 640              	    .if     \memAya < 599
 641              	        OpChi   #\memAya+600, r4, r5, r8, r9, r10
 642              	        OpChi   #\memAye+600, r5, r6, r9, r10, r11
 643              	        OpChi   #\memAyi+600, r6, r7, r10, r11, r12
 644              	        OpChi   #\memAyo+600, r7, r3, r11, r12, r8
 645              	        OpChi   #\memAyu+600, r3, r4, r12, r8, r9
 646              	    .else 
 647              	        OpChi   #\memAya-600, r4, r5, r8, r9, r10
 648              	        OpChi   #\memAye-600, r5, r6, r9, r10, r11
 649              	        OpChi   #\memAyi-600, r6, r7, r10, r11, r12
 650              	        OpChi   #\memAyo-600, r7, r3, r11, r12, r8
 651              	        OpChi   #\memAyu-600, r3, r4, r12, r8, r9
 652              	    .endif
 653              	
 654              	
 655              	    @PI+CHI APPLIED TO SHARE 2 (SHARES 0 - 1). Stack at this point (old --> new): r8-r12: Diffusion
 656              	    
 657              	    @Loading the half-lanes of share 1 (Theta+Rho already applied) into the group B of registers 
 658              	
 659              	    ldr     \reg_AyaB, [r0, #\memAya]             
 660              	    ldr     \reg_AyeB, [r0, #\memAye]         
 661              	    ldr     \reg_AyiB, [r0, #\memAyi]            
 662              	    ldr     \reg_AyoB, [r0, #\memAyo]           
 663              	    ldr     \reg_AyuB, [r0, #\memAyu]           
 664              	
 665              	    @At this point, the register values are:
 666              	    @   - r3-r7: half-lanes of the share 0 with Theta and Rho steps applied (Group A)
 667              	    @   - r8-r12: half-lanes of the share 1 with Theta and Rho steps applied (Group B)
 668              	    @The following expansions of OpChi macro computes the output share Y_2 from input shares
 669              	    @X_0, X_1 and write them in the corresponding memory address according to in-place processing
 670              	    @(it will be one of the other positions in the diagonal, but not the same)
 671              	    @If we read from memory zone A, we write in the corresponding memory zone B. Else, we have read
 672              	
 673              	    .if     \memAya < 599
 674              	        OpChi   #\memAya+800, r9, r10, r3, r4, r5
 675              	        OpChi   #\memAye+800, r10, r11, r4, r5, r6
 676              	        OpChi   #\memAyi+800, r11, r12, r5, r6, r7
 677              	        OpChi   #\memAyo+800, r12, r8, r6, r7, r3
 678              	        OpChi   #\memAyu+800, r8, r9, r7, r3, r4
 679              	    .else 
 680              	        OpChi   #\memAya-400, r9, r10, r3, r4, r5
 681              	        OpChi   #\memAye-400, r10, r11, r4, r5, r6
 682              	        OpChi   #\memAyi-400, r11, r12, r5, r6, r7
 683              	        OpChi   #\memAyo-400, r12, r8, r6, r7, r3
 684              	        OpChi   #\memAyu-400, r8, r9, r7, r3, r4
 685              	    .endif
 686              	
 687              	
 688              	    pop {r2, r8, r9, r10, r11, r12, lr}
 689              	.endm
 690              	
 691              	
 692              	
 693              	@----------------------------------------------------------------------------------
 694              	@--------------------------------KECCAKTHETARHOPICHIIOTA MACRO---------------------
 695              	@----------------------------------------------------------------------------------
 696              	@Used in the macros KeccakRound0, KeccakRound1, KeccakRound2, KeccakRound3 to compute
 697              	@the steps Theta, Rho, Pi, Chi, and apply the Round Constant of Iota step to lane Aba (0,0)
 698              	@
 699              	@It receives as inputs:
 700              	@   -memAya, memAye, memAyi, memAyo, memAyu: given the diagonal defined for in-place processing, me
 701              	@   -Dya, Dye, Dyi, Dyo, Dyu: registers where the diffusion values for each half-lane OF THE SHARE 
 702              	@   -rotAya, rotAye, rotAyi, rotAyo, rotAyu: rotation values for each half-lane according to rho st
 703              	@   -memDya, memDye, memDyi, memDyo, memDyu: memory addresses where the diffusion values for each h
 704              	@   -offset: offset applied to access to the round constant of Iota step
 705              	@   -last: flag to indicate if this is the last Iota applied in the fourth cyclic round
 706              	@Registers where lanes will be stores are fixed, due to the fact that this macro processes always t
 707              	@same diagonal (Aba, Age, Aki, Amo, Asu) --> Registers {r3-r7} and {r8-r12} of groups A and B, resp
 708              	
 709              	@----------------------------------------------------------------------------------
 710              	
 711              	.macro    KeccakThetaRhoPiChiIota  memAya, Dya, memAye, Dye, rotAye, memAyi, Dyi, rotAyi, memAyo, D
 712              	    
 713              	    @THETA+RHO APPLIED TO S1
 714              	    push {r2, r8, r9, r10, r11, r12, lr}
 715              	
 716              	    @Loading the half-lanes of share 1 into the group A registers
 717              	    ldr     r3, [r0, #\memAya]
 718              	    ldr     r4, [r0, #\memAye]
 719              	    ldr     r5, [r0, #\memAyi]
 720              	    ldr     r6, [r0, #\memAyo]
 721              	    ldr     r7, [r0, #\memAyu]
 722              	
 723              	    @ Applying diffusion values to the lanes of share 1
 724              	    eors    r3, r3, \Dya
 725              	    eors    r4, r4, \Dye
 726              	    eors    r5, r5, \Dyi
 727              	    eors    r6, r6, \Dyo
 728              	    eors    r7, r7, \Dyu
 729              	
 730              	    @ Applying rotations of the Rho step to the half-lanes of share 1
 731              	    .if  \rotAye > 0
 732              	        rors    r4, #32-\rotAye
 733              	    .endif
 734              	    rors    r5, #32-\rotAyi
 735              	    rors    r6, #32-\rotAyo
 736              	    rors    r7, #32-\rotAyu
 737              	
 738              	    @ Storing half-lanes of the share 1 after applying Theta+Rho
 739              	    str r3, [r0, #\memAya]
 740              	    str r4, [r0, #\memAye]
 741              	    str r5, [r0, #\memAyi]
 742              	    str r6, [r0, #\memAyo]
 743              	    str r7, [r0, #\memAyu]
 744              	
 745              	
 746              	
 747              	    @THETA+RHO APPLIED TO S2 
 748              	    @Loading the half-lanes of share 2 into the group B registers 
 749              	    @Loading the diffusion values for the half-lanes of share 2 into the auxiliar registers r1, r2,
 750              	    @Applying diffusion values to the half lanes of share 2  
 751              	    
 752              	    ldr     r8, [r0, #\memAya+200]
 753              	    ldr     r1, [r0, #\memDya+40]
 754              	    ldr     r9, [r0, #\memAye+200]
 755              	    ldr     r2, [r0, #\memDye+40]
 756              	    ldr     r10, [r0, #\memAyi+200]
 757              	    ldr     lr, [r0, #\memDyi+40]
 758              	
 759              	    eors    r8, r8, r1
 760              	    eors    r9, r9, r2
 761              	    eors    r10, r10, lr
 762              	
 763              	    ldr     r11, [r0, #\memAyo+200]
 764              	    ldr     r1, [r0, #\memDyo+40]
 765              	    ldr     r12, [r0, #\memAyu+200]
 766              	    ldr     lr, [r0, #\memDyu+40]
 767              	    
 768              	    eors    r11, r11, r1
 769              	    eors    r12, r12, lr
 770              	
 771              	    @ Applying rotations of the Rho step to the half-lanes of share 2     
 772              	    .if  \rotAye > 0
 773              	        rors    r9, #32-\rotAye
 774              	    .endif
 775              	    rors    r10, #32-\rotAyi
 776              	    rors    r11, #32-\rotAyo
 777              	    rors    r12, #32-\rotAyu
 778              	
 779              	
 780              	
 781              	
 782              	    @PI+CHI APPLIED TO SHARE 0 (SHARES 1 - 2)
 783              	
 784              	    @At this point, the register values are:
 785              	    @   - r3-r7: half-lanes of the share 1 with Theta and Rho steps applied (Group A)
 786              	    @   - r8-r12: half-lanes of the share 2 with Theta and Rho steps applied (Group B)
 787              	
 788              	    @The following expansions of OpChi macro computes the output share Y_0 from input shares
 789              	    @X_1, X_2 and write them in the corresponding memory address according to in-place processing
 790              	    @(it will be one of the other positions in the diagonal, but not the same)
 791              	
 792              	    @If we read from memory zone A, we write in the corresponding memory zone B. Else, we have read
 793              	    .if     \memAya < 599
 794              	        OpChi   #\memAya+400, r9, r10, r3, r4, r5
 795              	        OpChi   #\memAye+400, r10, r11, r4, r5, r6
 796              	        OpChi   #\memAyi+400, r11, r12, r5, r6, r7
 797              	        OpChi   #\memAyo+400, r12, r8, r6, r7, r3
 798              	        OpChi   #\memAyu+400, r8, r9, r7, r3, r4
 799              	    .else 
 800              	        OpChi   #\memAya-800, r9, r10, r3, r4, r5
 801              	        OpChi   #\memAye-800, r10, r11, r4, r5, r6
 802              	        OpChi   #\memAyi-800, r11, r12, r5, r6, r7
 803              	        OpChi   #\memAyo-800, r12, r8, r6, r7, r3
 804              	        OpChi   #\memAyu-800, r8, r9, r7, r3, r4
 805              	    .endif
 806              	
 807              	
 808              	
 809              	
 810              	    @THETA+RHO APPLIED TO S0. Stack at this point (old --> new): r8-r12: Diffusions, r3-r7: SHARE 1
 811              	
 812              	    @Loading the half-lanes of share 0 into the group A of registers 
 813              	    @Loading the diffusion values for the half-lanes of share 2 into the auxiliar registers r1, r2,
 814              	    @Applying diffusion values to the half lanes of share 2
 815              	
 816              	    ldr     r3, [r0, #\memAya-200]
 817              	    ldr     r1, [r0, #\memDya-40]
 818              	    ldr     r4, [r0, #\memAye-200]
 819              	    ldr     r2, [r0, #\memDye-40]
 820              	    ldr     r5, [r0, #\memAyi-200]
 821              	    ldr     lr, [r0, #\memDyi-40]
 822              	
 823              	    eors    r3, r3, r1
 824              	    eors    r4, r4, r2
 825              	    eors    r5, r5, lr
 826              	
 827              	
 828              	    ldr     r6, [r0, #\memAyo-200]
 829              	    ldr     r1, [r0, #\memDyo-40]
 830              	    ldr     r7, [r0, #\memAyu-200]
 831              	    ldr     lr, [r0, #\memDyu-40]
 832              	    
 833              	    eors    r6, r6, r1
 834              	    eors    r7, r7, lr
 835              	
 836              	    @ Applying rotations of the Rho step to the half-lanes of share 2
 837              	    .if  \rotAye > 0
 838              	        rors    r4, #32-\rotAye
 839              	    .endif
 840              	    rors    r5, #32-\rotAyi
 841              	    rors    r6, #32-\rotAyo
 842              	    rors    r7, #32-\rotAyu
 843              	
 844              	
 845              	
 846              	
 847              	    @PI+CHI APPLIED TO SHARE 1 (SHARES 2 - 0)
 848              	    @At this point, the register values are:
 849              	    @   - r3-r7: half-lanes of the share 0 with Theta and Rho steps applied (Group A)
 850              	    @   - r8-r12: half-lanes of the share 2 with Theta and Rho steps applied (Group B)
 851              	    @The following expansions of OpChi macro computes the output share Y_1 from input shares
 852              	    @X_2, X_0 and write them in the corresponding memory address according to in-place processing
 853              	    @(it will be one of the other positions in the diagonal, but not the same)
 854              	    @If we read from memory zone A, we write in the corresponding memory zone B. Else, we have read
 855              	
 856              	    .if     \memAya < 599
 857              	        OpChi   #\memAya+600, r4, r5, r8, r9, r10
 858              	        OpChi   #\memAye+600, r5, r6, r9, r10, r11
 859              	        OpChi   #\memAyi+600, r6, r7, r10, r11, r12
 860              	        OpChi   #\memAyo+600, r7, r3, r11, r12, r8
 861              	        OpChi   #\memAyu+600, r3, r4, r12, r8, r9
 862              	    .else 
 863              	        OpChi   #\memAya-600, r4, r5, r8, r9, r10
 864              	        OpChi   #\memAye-600, r5, r6, r9, r10, r11
 865              	        OpChi   #\memAyi-600, r6, r7, r10, r11, r12
 866              	        OpChi   #\memAyo-600, r7, r3, r11, r12, r8
 867              	        OpChi   #\memAyu-600, r3, r4, r12, r8, r9
 868              	    .endif
 869              	
 870              	
 871              	
 872              	    @PI+CHI APPLIED TO SHARE 2 (SHARES 0 - 1).
 873              	    @Loading the half-lanes of share 1 (Theta+Rho already applied) into the group B of registers
 874              	
 875              	    ldr     r8, [r0, #\memAya]
 876              	    ldr     r9, [r0, #\memAye]
 877              	    ldr     r10, [r0, #\memAyi]
 878              	    ldr     r11, [r0, #\memAyo]
 879              	    ldr     r12, [r0, #\memAyu]
 880              	
 881              	    @If we read from memory zone A, we write in the corresponding memory zone B. Else, we have read
 882              	    .if     \memAya < 599
 883              	        OpChi   #\memAye+800, r10, r11, r4, r5, r6
 884              	        OpChi   #\memAyi+800, r11, r12, r5, r6, r7
 885              	        OpChi   #\memAyo+800, r12, r8, r6, r7, r3
 886              	        OpChi   #\memAyu+800, r8, r9, r7, r3, r4
 887              	    .else 
 888              	        OpChi   #\memAye-400, r10, r11, r4, r5, r6
 889              	        OpChi   #\memAyi-400, r11, r12, r5, r6, r7
 890              	        OpChi   #\memAyo-400, r12, r8, r6, r7, r3
 891              	        OpChi   #\memAyu-400, r8, r9, r7, r3, r4
 892              	    .endif
 893              	
 894              	    @Loading the address where the Round Constants table starts
 895              	    ldr     r1, [r0, #mRC]
 896              	
 897              	    @Chi step applied to lane (0,0)
 898              	    eors r6, r3, r5
 899              	    and r7, r4, r5
 900              	    eors r6, r6, r7
 901              	    and r7, r4, r10
 902              	    eors r6, r6, r7
 903              	    and r7, r9, r5
 904              	    eors r6, r6, r7  
 905              	
 906              	    @Loading the Round Constant of Iota step applying the input offset to the memory address where 
 907              	    ldr     r4, [r1, #\offset]
 908              	
 909              	    @Lane(0,0) XOR RoundConstant 
 910              	    eors r6, r6, r4
 911              	
 912              	    .if  \last == 1
 913              	    ldr     r4, [r1, #32]!
 914              	    str     r1, [r0, #mRC]
 915              	    cmp     r4, #0xFF
 916              	    .endif
 917              	
 918              	    @Writing-back the lane (0,0) after applying Iota step in the writing memory zone
 919              	    .if     \memAya <599
 920              	        str     r6, [r0, #\memAya+800]
 921              	    .else
 922              	        str     r6, [r0, #\memAya-400]
 923              	    .endif
 924              	
 925              	
 926              	    pop {r2, r8, r9, r10, r11, r12, lr}
 927              	.endm
 928              	
 929              	
