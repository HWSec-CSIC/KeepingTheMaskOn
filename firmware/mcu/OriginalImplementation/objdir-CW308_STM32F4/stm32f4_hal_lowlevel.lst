 424:../.././hal/chipwhisperer-fw-extra/stm32f4/CMSIS/core/cmsis_gcc.h ****   \details Acts as a special kind of Data Memory Barrier.
 425:../.././hal/chipwhisperer-fw-extra/stm32f4/CMSIS/core/cmsis_gcc.h ****            It completes when all explicit memory accesses before this instruction complete.
 426:../.././hal/chipwhisperer-fw-extra/stm32f4/CMSIS/core/cmsis_gcc.h ****  */
 427:../.././hal/chipwhisperer-fw-extra/stm32f4/CMSIS/core/cmsis_gcc.h **** __attribute__((always_inline)) __STATIC_INLINE void __DSB(void)
 428:../.././hal/chipwhisperer-fw-extra/stm32f4/CMSIS/core/cmsis_gcc.h **** {
 429:../.././hal/chipwhisperer-fw-extra/stm32f4/CMSIS/core/cmsis_gcc.h ****   __ASM volatile ("dsb 0xF":::"memory");
 430:../.././hal/chipwhisperer-fw-extra/stm32f4/CMSIS/core/cmsis_gcc.h **** }
 431:../.././hal/chipwhisperer-fw-extra/stm32f4/CMSIS/core/cmsis_gcc.h **** 
