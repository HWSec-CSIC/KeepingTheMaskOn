 149:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         /* Wait till HSE is bypassed or disabled */
 150:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         while(__HAL_RCC_GET_FLAG(RCC_FLAG_HSERDY) != RESET)
