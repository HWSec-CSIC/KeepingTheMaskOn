 434:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   /* To correctly read data from FLASH memory, the number of wait states (LATENCY)
 435:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****     must be correctly programmed according to the frequency of the CPU clock
 436:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****     (HCLK) and the supply voltage of the device. */
 437:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** 
 438:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   /* Increasing the number of wait states because of higher CPU frequency */
 439:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   if(FLatency > (FLASH->ACR & FLASH_ACR_LATENCY))
