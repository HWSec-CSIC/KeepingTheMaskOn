 444:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****     /* Check that the new number of wait states is taken into account to access the Flash
 445:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****     memory by reading the FLASH_ACR register */
 446:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****     if((FLASH->ACR & FLASH_ACR_LATENCY) != FLatency)
 447:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****     {
