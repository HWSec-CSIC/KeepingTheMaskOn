 358:../.././hal/chipwhisperer-fw-extra/stm32f4/CMSIS/core/cmsis_gcc.h **** /* Define macros for porting to both thumb1 and thumb2.
 359:../.././hal/chipwhisperer-fw-extra/stm32f4/CMSIS/core/cmsis_gcc.h ****  * For thumb1, use low register (r0-r7), specified by constraint "l"
 360:../.././hal/chipwhisperer-fw-extra/stm32f4/CMSIS/core/cmsis_gcc.h ****  * Otherwise, use general registers, specified by constraint "r" */
 361:../.././hal/chipwhisperer-fw-extra/stm32f4/CMSIS/core/cmsis_gcc.h **** #if defined (__thumb__) && !defined (__thumb2__)
 362:../.././hal/chipwhisperer-fw-extra/stm32f4/CMSIS/core/cmsis_gcc.h **** #define __CMSIS_GCC_OUT_REG(r) "=l" (r)
 363:../.././hal/chipwhisperer-fw-extra/stm32f4/CMSIS/core/cmsis_gcc.h **** #define __CMSIS_GCC_USE_REG(r) "l" (r)
 364:../.././hal/chipwhisperer-fw-extra/stm32f4/CMSIS/core/cmsis_gcc.h **** #else
 365:../.././hal/chipwhisperer-fw-extra/stm32f4/CMSIS/core/cmsis_gcc.h **** #define __CMSIS_GCC_OUT_REG(r) "=r" (r)
 366:../.././hal/chipwhisperer-fw-extra/stm32f4/CMSIS/core/cmsis_gcc.h **** #define __CMSIS_GCC_USE_REG(r) "r" (r)
 367:../.././hal/chipwhisperer-fw-extra/stm32f4/CMSIS/core/cmsis_gcc.h **** #endif
