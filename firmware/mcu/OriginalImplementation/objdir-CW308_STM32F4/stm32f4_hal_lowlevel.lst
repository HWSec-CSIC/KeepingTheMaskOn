 670:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         /* Configure the IO Speed */
 671:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         temp = GPIOx->OSPEEDR;
 672:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         temp &= ~(GPIO_OSPEEDER_OSPEEDR0 << (position * 2U));
 673:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         temp |= (GPIO_Init->Speed << (position * 2U));
 674:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         GPIOx->OSPEEDR = temp;
 675:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** 
 676:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         /* Configure the IO Output Type */
 677:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         temp = GPIOx->OTYPER;
 678:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         temp &= ~(GPIO_OTYPER_OT_0 << position) ;
 679:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         temp |= (((GPIO_Init->Mode & GPIO_OUTPUT_TYPE) >> 4U) << position);
 680:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         GPIOx->OTYPER = temp;
 681:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****       }
 682:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** 
 683:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****       /* Activate the Pull-up or Pull down resistor for the current IO */
 684:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****       temp = GPIOx->PUPDR;
 685:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****       temp &= ~(GPIO_PUPDR_PUPDR0 << (position * 2U));
 686:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****       temp |= ((GPIO_Init->Pull) << (position * 2U));
 687:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****       GPIOx->PUPDR = temp;
 688:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** 
 689:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****       /*--------------------- EXTI Mode Configuration ------------------------*/
 690:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****       /* Configure the External Interrupt or event for the current IO */
 691:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****       if((GPIO_Init->Mode & EXTI_MODE) == EXTI_MODE)
 692:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****       {
 693:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         /* Enable SYSCFG Clock */
 694:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         __HAL_RCC_SYSCFG_CLK_ENABLE();
 695:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** 
 696:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         temp = SYSCFG->EXTICR[position >> 2U];
 697:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         temp &= ~(0x0FU << (4U * (position & 0x03U)));
 698:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         temp |= ((uint32_t)(GPIO_GET_INDEX(GPIOx)) << (4U * (position & 0x03U)));
 699:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         SYSCFG->EXTICR[position >> 2U] = temp;
 700:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** 
 701:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         /* Clear EXTI line configuration */
 702:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         temp = EXTI->IMR;
 703:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         temp &= ~((uint32_t)iocurrent);
 704:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         if((GPIO_Init->Mode & GPIO_MODE_IT) == GPIO_MODE_IT)
 705:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         {
 706:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****           temp |= iocurrent;
 707:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         }
 708:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         EXTI->IMR = temp;
 709:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** 
 710:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         temp = EXTI->EMR;
 711:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         temp &= ~((uint32_t)iocurrent);
 712:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         if((GPIO_Init->Mode & GPIO_MODE_EVT) == GPIO_MODE_EVT)
 713:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         {
 714:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****           temp |= iocurrent;
 715:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         }
 716:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         EXTI->EMR = temp;
 717:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** 
 718:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         /* Clear Rising Falling edge configuration */
 719:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         temp = EXTI->RTSR;
 720:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         temp &= ~((uint32_t)iocurrent);
 721:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         if((GPIO_Init->Mode & RISING_EDGE) == RISING_EDGE)
 722:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         {
 723:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****           temp |= iocurrent;
 724:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         }
 725:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         EXTI->RTSR = temp;
 726:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** 
 727:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         temp = EXTI->FTSR;
 728:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         temp &= ~((uint32_t)iocurrent);
 729:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         if((GPIO_Init->Mode & FALLING_EDGE) == FALLING_EDGE)
 730:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         {
 731:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****           temp |= iocurrent;
 732:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         }
 733:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         EXTI->FTSR = temp;
 734:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****       }
 735:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****     }
 736:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   }
 737:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** }
 738:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** 
 739:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** /**
 740:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   * @brief  Sets or clears the selected data port bit.
 741:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   *
 742:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   * @note   This function uses GPIOx_BSRR register to allow atomic read/modify
 743:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   *         accesses. In this way, there is no risk of an IRQ occurring between
 744:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   *         the read and the modify access.
 745:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   *
 746:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   * @param  GPIOx: where x can be (A..K) to select the GPIO peripheral for STM32F429X device or
 747:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   *                      x can be (A..I) to select the GPIO peripheral for STM32F40XX and STM32F427
 748:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   * @param  GPIO_Pin: specifies the port bit to be written.
 749:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   *          This parameter can be one of GPIO_PIN_x where x can be (0..15).
 750:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   * @param  PinState: specifies the value to be written to the selected bit.
 751:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   *          This parameter can be one of the GPIO_PinState enum values:
 752:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   *            @arg GPIO_PIN_RESET: to clear the port pin
 753:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   *            @arg GPIO_PIN_SET: to set the port pin
 754:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   * @retval None
 755:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   */
 756:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** void HAL_GPIO_WritePin(GPIO_TypeDef* GPIOx, uint16_t GPIO_Pin, GPIO_PinState PinState)
 757:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** {
 758:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   /* Check the parameters */
 759:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   assert_param(IS_GPIO_PIN(GPIO_Pin));
 760:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   assert_param(IS_GPIO_PIN_ACTION(PinState));
 761:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** 
 762:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   if(PinState != GPIO_PIN_RESET)
 763:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   {
 764:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****     GPIOx->BSRR = GPIO_Pin;
 765:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   }
 766:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   else
 767:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   {
 768:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****     GPIOx->BSRR = (uint32_t)GPIO_Pin << 16U;
 769:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   }
 770:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** }
 771:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** 
 772:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** 
 773:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** /**
 774:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   * @brief  Configures the UART peripheral.
 775:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   * @param  huart: pointer to a UART_HandleTypeDef structure that contains
 776:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   *                the configuration information for the specified UART module.
 777:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   * @retval None
 778:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   */
 779:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** static void UART_SetConfig(UART_HandleTypeDef *huart)
 780:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** {
 781:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   uint32_t tmpreg = 0x00U;
 782:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** 
 783:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   /* Check the parameters */
 784:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   assert_param(IS_UART_BAUDRATE(huart->Init.BaudRate));
 785:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   assert_param(IS_UART_STOPBITS(huart->Init.StopBits));
 786:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   assert_param(IS_UART_PARITY(huart->Init.Parity));
 787:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   assert_param(IS_UART_MODE(huart->Init.Mode));
 788:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** 
 789:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   /*-------------------------- USART CR2 Configuration -----------------------*/
 790:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   tmpreg = huart->Instance->CR2;
 791:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** 
 792:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   /* Clear STOP[13:12] bits */
 793:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   tmpreg &= (uint32_t)~((uint32_t)USART_CR2_STOP);
 794:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** 
 795:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   /* Configure the UART Stop Bits: Set STOP[13:12] bits according to huart->Init.StopBits value */
 796:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   tmpreg |= (uint32_t)huart->Init.StopBits;
 797:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** 
 798:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   /* Write to USART CR2 */
 799:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   WRITE_REG(huart->Instance->CR2, (uint32_t)tmpreg);
 800:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** 
 801:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   /*-------------------------- USART CR1 Configuration -----------------------*/
 802:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   tmpreg = huart->Instance->CR1;
 803:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** 
 804:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   /* Clear M, PCE, PS, TE and RE bits */
 805:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   tmpreg &= (uint32_t)~((uint32_t)(USART_CR1_M | USART_CR1_PCE | USART_CR1_PS | USART_CR1_TE | \
 806:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****                                    USART_CR1_RE | USART_CR1_OVER8));
 807:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** 
 808:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   /* Configure the UART Word Length, Parity and mode:
 809:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****      Set the M bits according to huart->Init.WordLength value
 810:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****      Set PCE and PS bits according to huart->Init.Parity value
 811:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****      Set TE and RE bits according to huart->Init.Mode value
 812:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****      Set OVER8 bit according to huart->Init.OverSampling value */
 813:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   tmpreg |= (uint32_t)huart->Init.WordLength | huart->Init.Parity | huart->Init.Mode | huart->Init.
 814:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** 
 815:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   /* Write to USART CR1 */
 816:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   WRITE_REG(huart->Instance->CR1, (uint32_t)tmpreg);
 817:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** 
 818:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   /*-------------------------- USART CR3 Configuration -----------------------*/
 819:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   tmpreg = huart->Instance->CR3;
 820:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** 
 821:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   /* Clear CTSE and RTSE bits */
 822:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   tmpreg &= (uint32_t)~((uint32_t)(USART_CR3_RTSE | USART_CR3_CTSE));
 823:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** 
 824:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   /* Configure the UART HFC: Set CTSE and RTSE bits according to huart->Init.HwFlowCtl value */
 825:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   tmpreg |= huart->Init.HwFlowCtl;
 826:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** 
 827:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   /* Write to USART CR3 */
 828:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   WRITE_REG(huart->Instance->CR3, (uint32_t)tmpreg);
 829:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** 
 830:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   /* Check the Over Sampling */
 831:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   if(huart->Init.OverSampling == UART_OVERSAMPLING_8)
 832:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   {
 833:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****     /*-------------------------- USART BRR Configuration ---------------------*/
 834:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** #if defined(USART6)
 835:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****     if((huart->Instance == USART1) || (huart->Instance == USART6))
 836:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****     {
