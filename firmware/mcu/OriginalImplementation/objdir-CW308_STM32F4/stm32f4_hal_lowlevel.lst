  58:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** /**
  59:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   * @brief  Enables or disables the AHB2 peripheral clock.
  60:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   * @note   After reset, the peripheral clock (used for registers read/write access)
  61:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   *         is disabled and the application software has to enable this clock before 
  62:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   *         using it. 
  63:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   * @param  RCC_AHBPeriph: specifies the AHB2 peripheral to gates its clock.
  64:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   *          This parameter can be any combination of the following values:
  65:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   *            @arg RCC_AHB2Periph_DCMI:   DCMI clock
  66:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   *            @arg RCC_AHB2Periph_CRYP:   CRYP clock
  67:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   *            @arg RCC_AHB2Periph_HASH:   HASH clock
  68:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   *            @arg RCC_AHB2Periph_RNG:    RNG clock
  69:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   *            @arg RCC_AHB2Periph_OTG_FS: USB OTG FS clock
  70:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   * @param  NewState: new state of the specified peripheral clock.
  71:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   *          This parameter can be: ENABLE or DISABLE.
  72:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   * @retval None
  73:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   */
  74:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** void RCC_AHB2PeriphClockCmd(uint32_t RCC_AHB2Periph, FunctionalState NewState)
  75:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** {
  76:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   /* Check the parameters */
  77:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   assert_param(IS_RCC_AHB2_PERIPH(RCC_AHB2Periph));
  78:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   assert_param(IS_FUNCTIONAL_STATE(NewState));
  79:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** 
  80:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   if (NewState != DISABLE)
  81:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   {
  82:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****     RCC->AHB2ENR |= RCC_AHB2Periph;
  83:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   }
  84:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   else
  85:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   {
  86:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****     RCC->AHB2ENR &= ~RCC_AHB2Periph;
  87:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   }
  88:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c **** }
