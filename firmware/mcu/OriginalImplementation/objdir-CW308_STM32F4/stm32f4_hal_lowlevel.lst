 389:../.././hal/chipwhisperer-fw-extra/stm32f4/CMSIS/core/cmsis_gcc.h **** /**
 390:../.././hal/chipwhisperer-fw-extra/stm32f4/CMSIS/core/cmsis_gcc.h ****   \brief   Wait For Event
 391:../.././hal/chipwhisperer-fw-extra/stm32f4/CMSIS/core/cmsis_gcc.h ****   \details Wait For Event is a hint instruction that permits the processor to enter
 392:../.././hal/chipwhisperer-fw-extra/stm32f4/CMSIS/core/cmsis_gcc.h ****     a low-power state until one of a number of events occurs.
 393:../.././hal/chipwhisperer-fw-extra/stm32f4/CMSIS/core/cmsis_gcc.h ****  */
