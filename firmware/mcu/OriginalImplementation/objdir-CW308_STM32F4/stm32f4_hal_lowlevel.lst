 115:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****     /* When the HSE is used as system clock or clock source for PLL in these cases HSE will not dis
 116:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****     if((__HAL_RCC_GET_SYSCLK_SOURCE() == RCC_CFGR_SWS_HSE) ||\
 117:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****       ((__HAL_RCC_GET_SYSCLK_SOURCE() == RCC_CFGR_SWS_PLL) && ((RCC->PLLCFGR & RCC_PLLCFGR_PLLSRC) 
 118:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****     {
 119:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****       if((__HAL_RCC_GET_FLAG(RCC_FLAG_HSERDY) != RESET) && (RCC_OscInitStruct->HSEState == RCC_HSE_
 120:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****       {
 121:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****         return HAL_ERROR;
 122:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****       }
 123:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****     }
