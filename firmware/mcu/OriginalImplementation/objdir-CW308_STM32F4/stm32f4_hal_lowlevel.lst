 108:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   /* Check the parameters */
 109:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   assert_param(IS_RCC_OSCILLATORTYPE(RCC_OscInitStruct->OscillatorType));
 110:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   /*------------------------------- HSE Configuration ------------------------*/
 111:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   if(((RCC_OscInitStruct->OscillatorType) & RCC_OSCILLATORTYPE_HSE) == RCC_OSCILLATORTYPE_HSE)
 112:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****   {
 113:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4_hal_lowlevel.c ****     /* Check the parameters */
