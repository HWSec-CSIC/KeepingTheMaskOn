 1137              	
 1138              	    xor5        r5,  Aki1_s2_M2, Asi1_s2_M2, Agi0_s2_M2, Ami1_s2_M2, Abi0_s2_M2
 1139              	    xorrol      r9, r5, r6
 1140              	    str         r9, [r0, #mDo0_s2]
 1141              	    xor5        r4,  Aki0_s2_M2, Asi0_s2_M2, Agi1_s2_M2, Ami0_s2_M2, Abi1_s2_M2
 1142              	    eors        r3, r3, r4
