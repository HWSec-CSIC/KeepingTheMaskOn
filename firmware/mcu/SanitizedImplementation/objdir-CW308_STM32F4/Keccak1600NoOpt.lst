 1163              	
 1164              	    @DIFFUSION SHARE 1
 1165              	    xor5        r3,  Asu0_s1_M2, Agu0_s1_M2, Amu0_s1_M2, Abu1_s1_M2, Aku1_s1_M2
 1166              	    xor5        r7,  Age1_s1_M2, Ame0_s1_M2, Abe0_s1_M2, Ake1_s1_M2, Ase1_s1_M2
