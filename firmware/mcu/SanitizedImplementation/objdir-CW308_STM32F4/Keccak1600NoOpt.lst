 1148              	    xor5        r6,  Aba1_s2_M2, Aka0_s2_M2, Asa1_s2_M2, Aga1_s2_M2, Ama0_s2_M2
 1149              	    eors        r11, r6, r5
 1150              	    str         r11, [r0, #mDe1_s2]
 1151              	
 1152              	    xor5        r4,  Amo0_s2_M2, Abo1_s2_M2, Ako0_s2_M2, Aso1_s2_M2, Ago0_s2_M2
 1153              	    xorrol      r5, lr, r4
 1154              	    str         r5, [r0, #mDi0_s2]
 1155              	    xor5        r5,  Amo1_s2_M2, Abo0_s2_M2, Ako1_s2_M2, Aso0_s2_M2, Ago1_s2_M2
 1156              	    eors        r2, r7, r5
 1157              	    str         r2, [r0, #mDi1_s2]
 1158              	
 1159              	    xorrol      r12, r5, r6
