 380              	
 381              	@----------------------------------------------------------------------------------
 382              	@-----------------------------------------XOR5 MACRO-------------------------------
 383              	@----------------------------------------------------------------------------------
 384              	@Used in theta step (at the beginning of each macro KeccakRound0, KeccakRound1, 
 385              	@KeccakRound2, KeccakRound3) to compute the parities C(x) of each column (considering
 386              	@a particular half and share). 
 387              	@
 388              	@It receives as inputs:
 389              	@   -i1, i2, i3, i4, i5: memory addresses where 32-bit lanes from the same column, half, and share
 390              	@                        are stored in the INPUT SPACE
 391              	@   -res: register where the parity value will be stored 
 392              	@
 393              	@This macro XORs all i1, i2, i3, i4, i5 inputs and stores the result in the "res" register
 394              	@
 395              	@Equivalent operation: res <-- i1 XOR i2 XOR i3 XOR i4 XOR i5
 396              	@
 397              	@Intermediate registers: r1, r2, r12
 398              	@----------------------------------------------------------------------------------
 399              	
 400              	
 401              	.macro    xor5      res, i1, i2, i3, i4, i5
 402              	    ldr         \res, [r0, #\i1]
 403              	    ldr         r1, [r0, #\i2]
 404              	    ldr         r2, [r0, #\i3]
 405              	    ldr         r12, [r0, #\i4]
 406              	    eors        \res, \res, r1
 407              	    eors        \res, \res, r2
 408              	    eors        \res, \res, r12
 409              	    ldr         r1, [r0, #\i5]
 410              	    eors        \res, \res, r1
 411              	.endm
 412              	
 413              	
 414              	@----------------------------------------------------------------------------------
 415              	@----------------------------------------XORROL MACRO------------------------------
 416              	@----------------------------------------------------------------------------------
 417              	@Used in theta step (at the beginning of each macro KeccakRound0, KeccakRound1, 
 418              	@KeccakRound2, KeccakRound3) to compute the diffusions D(x) of low halfs of the lanes
 419              	@in the OUTPUT space.
 420              	@
 421              	@It receives as inputs:
 422              	@   -aa, bb: registers containing the 32-bit half-lanes that will be XORed
 423              	@   -res: register where the resulting 
 424              	@ 
 425              	@This macro XORs the input "aa" with the input "bb" rotated left by 1 bit,
 426              	@and stores it in the "res" register.
 427              	@
 428              	@Equivalent operation: res <-- aa XOR ROTL(bb, 1)
 429              	@
 430              	@Intermediate registers: None
 431              	@----------------------------------------------------------------------------------
 432              	
 433              	
 434              	
 435              	.macro    xorrol      res, aa, bb
 436              	    eor         \res, \aa, \bb, ROR #31
 437              	.endm
 438              	
 439              	
 440              	@----------------------------------------------------------------------------------
 441              	@----------------------------------------OPCHI MACRO-------------------------------
 442              	@----------------------------------------------------------------------------------
 443              	@Used in the macros KeccakThetaRhoPiChi and KeccakThetaRhoPiChiIota to
 444              	@compute the masked Chi function for one given share.
 445              	@
 446              	@For a given row, it computes the share j of the lane i (Y^i_j) at the output of the 
 447              	@Chi step using the 32-bit half-lanes i, i+1, i+2 of the shares j+1, j+2 (X_{j+1}, X_{j+2})
 448              	@
 449              	@It receives as inputs:
 450              	@   -Ia0, Ia1, Ia2: for a given row, registers containing the 32-bit half-lanes i, i+1, i+2 of the 
 451              	@   -Ib1, Ib2: for a given row, registers containing the 32-bit half-lanes i+1, i+2 of the share j+
 452              	@   -memW: memory address where the resulting Y^i_j will be stored
 453              	@
 454              	@Equivalent operation: Y^i_j <-- f(X_{j+1}, X_{j+2}) = 
 455              	@ =X^{i}_{j+1} XOR X^{i+2}_{j+1} XOR (X^{i+1}_{j+1} & X^{i+2}_{j+1}) XOR (X^{i+1}_{j+1} & X^{i+2}_{
 456              	@
 457              	@Intermediate registers: r1, r2
 458              	@----------------------------------------------------------------------------------
 459              	
 460              	
 461              	
 462              	.macro    OpChi      memW, Ib1, Ib2, Ia0, Ia1, Ia2
 463              	    eors r1, \Ia0, \Ia2
 464              	    and r2, \Ia1, \Ia2
 465              	    eors r1, r1, r2
 466              	    and r2, \Ia1, \Ib2
 467              	    eors r1, r1, r2
 468              	    and r2, \Ib1, \Ia2 
 469              	    eors r1, r1, r2
 470              	    str r1, [r0, \memW]
 471              	.endm
 472              	
 473              	
 474              	@----------------------------------------------------------------------------------
 475              	@----------------------------------KECCAKTHETARHOPICHI MACRO-----------------------
 476              	@----------------------------------------------------------------------------------
 477              	@Used in the macros KeccakRound0, KeccakRound1, KeccakRound2, KeccakRound3 to compute
 478              	@the steps Theta, Rho, Pi Chi.
 479              	@
 480              	@It receives as inputs:
 481              	@   -reg_Aya, reg_Aye, reg_Ayi, reg_Ayo, reg_Ayu: given the diagonal defined for in-place processin
 482              	@   -reg_AyaB, reg_AyeB, reg_AyiB, reg_AyoB, reg_AyuB: given the diagonal defined for in-place proc
 483              	@   -memAya, memAye, memAyi, memAyo, memAyu: given the diagonal defined for in-place processing, me
 484              	@   -Dya, Dye, Dyi, Dyo, Dyu: registers where the diffusion values for each half-lane OF THE SHARE 
 485              	@   -memDya, memDye, memDyi, memDyo, memDyu: memory addresses where the diffusion values for each h
 486              	@   -rotAya, rotAye, rotAyi, rotAyo, rotAyu: rotation values for each half-lane according to rho st
 487              	@
 488              	@Although the group A and group B of registers contains always {r3-r7} and {r8-r12}, respectively, 
 489              	@----------------------------------------------------------------------------------
 490              	
 491              	
 492              	
 493              	.macro    KeccakThetaRhoPiChi reg_Aya, memAya, Dya, rotAya, reg_Aye, memAye, Dye, rotAye, reg_Ayi, 
 494              	    @THETA+RHO APPLIED TO S1
 495              	    push {r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, r11, r12, lr}
 496              	
 497              	
 498              	    @Loading the half-lanes of share 1 into the group A registers
 499              	    ldr     \reg_Aya, [r0, #\memAya]
 500              	    ldr     \reg_Aye, [r0, #\memAye]
 501              	    ldr     \reg_Ayi, [r0, #\memAyi]
 502              	    ldr     \reg_Ayo, [r0, #\memAyo]
 503              	    ldr     \reg_Ayu, [r0, #\memAyu]
 504              	
 505              	    @ Applying diffusion values to the lanes of share 1
 506              	    eors    \reg_Aya, \reg_Aya, \Dya
 507              	    eors    \reg_Aye, \reg_Aye, \Dye
 508              	    eors    \reg_Ayi, \reg_Ayi, \Dyi
 509              	    eors    \reg_Ayo, \reg_Ayo, \Dyo
 510              	    eors    \reg_Ayu, \reg_Ayu, \Dyu
 511              	
 512              	
 513              	    @ Applying rotations of the Rho step to the half-lanes of share 1
 514              	    rors    \reg_Aya, #32-\rotAya
 515              	    .if  \rotAye > 0
 516              	        rors    \reg_Aye, #32-\rotAye
 517              	    .endif
 518              	    rors    \reg_Ayi, #32-\rotAyi
 519              	    rors    \reg_Ayo, #32-\rotAyo
 520              	    rors    \reg_Ayu, #32-\rotAyu
 521              	
 522              	
 523              	    @ Storing half-lanes of the share 1 after applying Theta+Rho
 524              	    str \reg_Aya, [r0, #\memAya]
 525              	    str \reg_Aye, [r0, #\memAye]
 526              	    str \reg_Ayi, [r0, #\memAyi]
 527              	    str \reg_Ayo, [r0, #\memAyo]
 528              	    str \reg_Ayu, [r0, #\memAyu]
 529              	
 530              	
 531              	
 532              	    @THETA+RHO APPLIED TO S2 
 533              	    @Loading the half-lanes of share 2 into the group B registers 
 534              	    @Loading the diffusion values for the half-lanes of share 2 into the auxiliar registers r1, r2,
 535              	    @Applying diffusion values to the half lanes of share 2
 536              	    
 537              	    ldr     \reg_AyaB, [r0, #\memAya+200]
 538              	    ldr     r1, [r0, #\memDya+40]
 539              	    ldr     \reg_AyeB, [r0, #\memAye+200]
 540              	    ldr     r2, [r0, #\memDye+40]
 541              	    ldr     \reg_AyiB, [r0, #\memAyi+200]
 542              	    ldr     lr, [r0, #\memDyi+40]
 543              	
 544              	    eors    \reg_AyaB, \reg_AyaB, r1
 545              	    eors    \reg_AyeB, \reg_AyeB, r2
 546              	    eors    \reg_AyiB, \reg_AyiB, lr
 547              	
 548              	    ldr     \reg_AyoB, [r0, #\memAyo+200]
 549              	    ldr     r1, [r0, #\memDyo+40]
 550              	    ldr     \reg_AyuB, [r0, #\memAyu+200]
 551              	    ldr     lr, [r0, #\memDyu+40]
 552              	    
 553              	    eors    \reg_AyoB, \reg_AyoB, r1
 554              	    eors    \reg_AyuB, \reg_AyuB, lr   
 555              	    
 556              	    @ Applying rotations of the Rho step to the half-lanes of share 2
 557              	    rors    \reg_AyaB, #32-\rotAya
 558              	    .if  \rotAye > 0
 559              	        rors    \reg_AyeB, #32-\rotAye
 560              	    .endif
 561              	    rors    \reg_AyiB, #32-\rotAyi
 562              	    rors    \reg_AyoB, #32-\rotAyo
 563              	    rors    \reg_AyuB, #32-\rotAyu
 564              	
 565              	
 566              	
 567              	    @PI+CHI APPLIED TO SHARE 0 (SHARES 1 - 2). 
 568              	    @At this point, the register values are:
 569              	    @   - r3-r7: half-lanes of the share 1 with Theta and Rho steps applied (Group A)
 570              	    @   - r8-r12: half-lanes of the share 2 with Theta and Rho steps applied (Group B)
 571              	
 572              	    @The following expansions of OpChi macro computes the output share Y_0 from input shares
 573              	    @X_1, X_2 and write them in the corresponding memory address according to in-place processing
 574              	    @(it will be one of the other positions in the diagonal, but not the same)
 575              	    @If we read from memory zone A, we write in the corresponding memory zone B. Else, we have read
 576              	
 577              	    push {r1, r2}
 578              	    .if     \memAya < 599
 579              	        OpChi   #\memAya+400, r9, r10, r3, r4, r5
 580              	        OpChi   #\memAye+400, r10, r11, r4, r5, r6
 581              	        OpChi   #\memAyi+400, r11, r12, r5, r6, r7
 582              	        OpChi   #\memAyo+400, r12, r8, r6, r7, r3
 583              	        OpChi   #\memAyu+400, r8, r9, r7, r3, r4
 584              	    .else 
 585              	        OpChi   #\memAya-800, r9, r10, r3, r4, r5
 586              	        OpChi   #\memAye-800, r10, r11, r4, r5, r6
 587              	        OpChi   #\memAyi-800, r11, r12, r5, r6, r7
 588              	        OpChi   #\memAyo-800, r12, r8, r6, r7, r3
 589              	        OpChi   #\memAyu-800, r8, r9, r7, r3, r4
 590              	    .endif
 591              	    pop {r1, r2}
 592              	
 593              	
 594              	
 595              	    @THETA+RHO APPLIED TO S0
 596              	
 597              	    @Loading the half-lanes of share 0 into the group A of registers 
 598              	    @Loading the diffusion values for the half-lanes of share 2 into the auxiliar registers r1, r2,
 599              	    @Applying diffusion values to the half lanes of share 2
 600              	
 601              	    ldr     \reg_Aya, [r0, #\memAya-200]
 602              	    ldr     r1, [r0, #\memDya-40]
 603              	    ldr     \reg_Aye, [r0, #\memAye-200]
 604              	    ldr     r2, [r0, #\memDye-40]
 605              	    ldr     \reg_Ayi, [r0, #\memAyi-200]
 606              	    ldr     lr, [r0, #\memDyi-40]
 607              	
 608              	    eors    \reg_Aya, \reg_Aya, r1
 609              	    eors    \reg_Aye, \reg_Aye, r2
 610              	    eors    \reg_Ayi, \reg_Ayi, lr
 611              	
 612              	
 613              	    ldr     \reg_Ayo, [r0, #\memAyo-200]
 614              	    ldr     r1, [r0, #\memDyo-40]
 615              	    ldr     \reg_Ayu, [r0, #\memAyu-200]
 616              	    ldr     lr, [r0, #\memDyu-40]
 617              	    
 618              	    eors    \reg_Ayo, \reg_Ayo, r1
 619              	    eors    \reg_Ayu, \reg_Ayu, lr
 620              	    
 621              	    @ Applying rotations of the Rho step to the half-lanes of share 2
 622              	
 623              	    rors    \reg_Aya, #32-\rotAya
 624              	    .if  \rotAye > 0
 625              	        rors    \reg_Aye, #32-\rotAye
 626              	    .endif
 627              	    rors    \reg_Ayi, #32-\rotAyi
 628              	    rors    \reg_Ayo, #32-\rotAyo
 629              	    rors    \reg_Ayu, #32-\rotAyu
 630              	
 631              	
 632              	
 633              	    @PI+CHI APPLIED TO SHARE 1 (SHARES 2 - 0)
 634              	    @At this point, the register values are:
 635              	    @   - r3-r7: half-lanes of the share 0 with Theta and Rho steps applied (Group A)
 636              	    @   - r8-r12: half-lanes of the share 2 with Theta and Rho steps applied (Group B)
 637              	    @The following expansions of OpChi macro computes the output share Y_1 from input shares
 638              	    @X_2, X_0 and write them in the corresponding memory address according to in-place processing
 639              	    @(it will be one of the other positions in the diagonal, but not the same)
 640              	    @If we read from memory zone A, we write in the corresponding memory zone B. Else, we have read
 641              	    
 642              	    push {r1, r2}
 643              	    .if     \memAya < 599
 644              	        OpChi   #\memAya+600, r4, r5, r8, r9, r10
 645              	        OpChi   #\memAye+600, r5, r6, r9, r10, r11
 646              	        OpChi   #\memAyi+600, r6, r7, r10, r11, r12
 647              	        OpChi   #\memAyo+600, r7, r3, r11, r12, r8
 648              	        OpChi   #\memAyu+600, r3, r4, r12, r8, r9
 649              	    .else 
 650              	        OpChi   #\memAya-600, r4, r5, r8, r9, r10
 651              	        OpChi   #\memAye-600, r5, r6, r9, r10, r11
 652              	        OpChi   #\memAyi-600, r6, r7, r10, r11, r12
 653              	        OpChi   #\memAyo-600, r7, r3, r11, r12, r8
 654              	        OpChi   #\memAyu-600, r3, r4, r12, r8, r9
 655              	    .endif
 656              	    pop {r1, r2}
 657              	
 658              	
 659              	    @PI+CHI APPLIED TO SHARE 2 (SHARES 0 - 1). Stack at this point (old --> new): r8-r12: Diffusion
 660              	    
 661              	    @Loading the half-lanes of share 1 (Theta+Rho already applied) into the group B of registers 
 662              	
 663              	    ldr     \reg_AyaB, [r0, #\memAya]             
 664              	    ldr     \reg_AyeB, [r0, #\memAye]         
 665              	    ldr     \reg_AyiB, [r0, #\memAyi]            
 666              	    ldr     \reg_AyoB, [r0, #\memAyo]           
 667              	    ldr     \reg_AyuB, [r0, #\memAyu]           
 668              	
 669              	    @At this point, the register values are:
 670              	    @   - r3-r7: half-lanes of the share 0 with Theta and Rho steps applied (Group A)
 671              	    @   - r8-r12: half-lanes of the share 1 with Theta and Rho steps applied (Group B)
 672              	    @The following expansions of OpChi macro computes the output share Y_2 from input shares
 673              	    @X_0, X_1 and write them in the corresponding memory address according to in-place processing
 674              	    @(it will be one of the other positions in the diagonal, but not the same)
 675              	    @If we read from memory zone A, we write in the corresponding memory zone B. Else, we have read
 676              	
 677              	    push {r1, r2}
 678              	    .if     \memAya < 599
 679              	        OpChi   #\memAya+800, r9, r10, r3, r4, r5
 680              	        OpChi   #\memAye+800, r10, r11, r4, r5, r6
 681              	        OpChi   #\memAyi+800, r11, r12, r5, r6, r7
 682              	        OpChi   #\memAyo+800, r12, r8, r6, r7, r3
 683              	        OpChi   #\memAyu+800, r8, r9, r7, r3, r4
 684              	    .else 
 685              	        OpChi   #\memAya-400, r9, r10, r3, r4, r5
 686              	        OpChi   #\memAye-400, r10, r11, r4, r5, r6
 687              	        OpChi   #\memAyi-400, r11, r12, r5, r6, r7
 688              	        OpChi   #\memAyo-400, r12, r8, r6, r7, r3
 689              	        OpChi   #\memAyu-400, r8, r9, r7, r3, r4
 690              	    .endif
 691              	    pop {r1, r2}
 692              	
 693              	
 694              	    pop {r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, r11, r12, lr}
 695              	.endm
 696              	
 697              	
 698              	
 699              	@----------------------------------------------------------------------------------
 700              	@--------------------------------KECCAKTHETARHOPICHIIOTA MACRO---------------------
 701              	@----------------------------------------------------------------------------------
 702              	@Used in the macros KeccakRound0, KeccakRound1, KeccakRound2, KeccakRound3 to compute
 703              	@the steps Theta, Rho, Pi, Chi, and apply the Round Constant of Iota step to lane Aba (0,0)
 704              	@
 705              	@It receives as inputs:
 706              	@   -memAya, memAye, memAyi, memAyo, memAyu: given the diagonal defined for in-place processing, me
 707              	@   -Dya, Dye, Dyi, Dyo, Dyu: registers where the diffusion values for each half-lane OF THE SHARE 
 708              	@   -rotAya, rotAye, rotAyi, rotAyo, rotAyu: rotation values for each half-lane according to rho st
 709              	@   -memDya, memDye, memDyi, memDyo, memDyu: memory addresses where the diffusion values for each h
 710              	@   -offset: offset applied to access to the round constant of Iota step
 711              	@   -last: flag to indicate if this is the last Iota applied in the fourth cyclic round
 712              	@Registers where lanes will be stores are fixed, due to the fact that this macro processes always t
 713              	@same diagonal (Aba, Age, Aki, Amo, Asu) --> Registers {r3-r7} and {r8-r12} of groups A and B, resp
 714              	
 715              	@----------------------------------------------------------------------------------
 716              	
 717              	.macro    KeccakThetaRhoPiChiIota  memAya, Dya, memAye, Dye, rotAye, memAyi, Dyi, rotAyi, memAyo, D
 718              	    
 719              	    @THETA+RHO APPLIED TO S1
 720              	    push {r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, r11, r12, lr}
 721              	
 722              	    @Loading the half-lanes of share 1 into the group A registers
 723              	    ldr     r3, [r0, #\memAya]
 724              	    ldr     r4, [r0, #\memAye]
 725              	    ldr     r5, [r0, #\memAyi]
 726              	    ldr     r6, [r0, #\memAyo]
 727              	    ldr     r7, [r0, #\memAyu]
 728              	
 729              	    @ Applying diffusion values to the lanes of share 1
 730              	    eors    r3, r3, \Dya
 731              	    eors    r4, r4, \Dye
 732              	    eors    r5, r5, \Dyi
 733              	    eors    r6, r6, \Dyo
 734              	    eors    r7, r7, \Dyu
 735              	
 736              	    @ Applying rotations of the Rho step to the half-lanes of share 1
 737              	    .if  \rotAye > 0
 738              	        rors    r4, #32-\rotAye
 739              	    .endif
 740              	    rors    r5, #32-\rotAyi
 741              	    rors    r6, #32-\rotAyo
 742              	    rors    r7, #32-\rotAyu
 743              	
 744              	    @ Storing half-lanes of the share 1 after applying Theta+Rho
 745              	    str r3, [r0, #\memAya]
 746              	    str r4, [r0, #\memAye]
 747              	    str r5, [r0, #\memAyi]
 748              	    str r6, [r0, #\memAyo]
 749              	    str r7, [r0, #\memAyu]
 750              	
 751              	
 752              	
 753              	    @THETA+RHO APPLIED TO S2 
 754              	    @Loading the half-lanes of share 2 into the group B registers 
 755              	    @Loading the diffusion values for the half-lanes of share 2 into the auxiliar registers r1, r2,
 756              	    @Applying diffusion values to the half lanes of share 2  
 757              	    
 758              	    ldr     r8, [r0, #\memAya+200]
 759              	    ldr     r1, [r0, #\memDya+40]
 760              	    ldr     r9, [r0, #\memAye+200]
 761              	    ldr     r2, [r0, #\memDye+40]
 762              	    ldr     r10, [r0, #\memAyi+200]
 763              	    ldr     lr, [r0, #\memDyi+40]
 764              	
 765              	    eors    r8, r8, r1
 766              	    eors    r9, r9, r2
 767              	    eors    r10, r10, lr
 768              	
 769              	    ldr     r11, [r0, #\memAyo+200]
 770              	    ldr     r1, [r0, #\memDyo+40]
 771              	    ldr     r12, [r0, #\memAyu+200]
 772              	    ldr     lr, [r0, #\memDyu+40]
 773              	    
 774              	    eors    r11, r11, r1
 775              	    eors    r12, r12, lr
 776              	
 777              	    @ Applying rotations of the Rho step to the half-lanes of share 2     
 778              	    .if  \rotAye > 0
 779              	        rors    r9, #32-\rotAye
 780              	    .endif
 781              	    rors    r10, #32-\rotAyi
 782              	    rors    r11, #32-\rotAyo
 783              	    rors    r12, #32-\rotAyu
 784              	
 785              	
 786              	
 787              	
 788              	    @PI+CHI APPLIED TO SHARE 0 (SHARES 1 - 2)
 789              	
 790              	    @At this point, the register values are:
 791              	    @   - r3-r7: half-lanes of the share 1 with Theta and Rho steps applied (Group A)
 792              	    @   - r8-r12: half-lanes of the share 2 with Theta and Rho steps applied (Group B)
 793              	
 794              	    @The following expansions of OpChi macro computes the output share Y_0 from input shares
 795              	    @X_1, X_2 and write them in the corresponding memory address according to in-place processing
 796              	    @(it will be one of the other positions in the diagonal, but not the same)
 797              	
 798              	    @If we read from memory zone A, we write in the corresponding memory zone B. Else, we have read
 799              	    
 800              	    push {r1, r2}
 801              	    .if     \memAya < 599
 802              	        OpChi   #\memAya+400, r9, r10, r3, r4, r5
 803              	        OpChi   #\memAye+400, r10, r11, r4, r5, r6
 804              	        OpChi   #\memAyi+400, r11, r12, r5, r6, r7
 805              	        OpChi   #\memAyo+400, r12, r8, r6, r7, r3
 806              	        OpChi   #\memAyu+400, r8, r9, r7, r3, r4
 807              	    .else 
 808              	        OpChi   #\memAya-800, r9, r10, r3, r4, r5
 809              	        OpChi   #\memAye-800, r10, r11, r4, r5, r6
 810              	        OpChi   #\memAyi-800, r11, r12, r5, r6, r7
 811              	        OpChi   #\memAyo-800, r12, r8, r6, r7, r3
 812              	        OpChi   #\memAyu-800, r8, r9, r7, r3, r4
 813              	    .endif
 814              	    pop {r1, r2}
 815              	
 816              	
 817              	
 818              	
 819              	    @THETA+RHO APPLIED TO S0. Stack at this point (old --> new): r8-r12: Diffusions, r3-r7: SHARE 1
 820              	
 821              	    @Loading the half-lanes of share 0 into the group A of registers 
 822              	    @Loading the diffusion values for the half-lanes of share 2 into the auxiliar registers r1, r2,
 823              	    @Applying diffusion values to the half lanes of share 2
 824              	
 825              	    ldr     r3, [r0, #\memAya-200]
 826              	    ldr     r1, [r0, #\memDya-40]
 827              	    ldr     r4, [r0, #\memAye-200]
 828              	    ldr     r2, [r0, #\memDye-40]
 829              	    ldr     r5, [r0, #\memAyi-200]
 830              	    ldr     lr, [r0, #\memDyi-40]
 831              	
 832              	    eors    r3, r3, r1
 833              	    eors    r4, r4, r2
 834              	    eors    r5, r5, lr
 835              	
 836              	
 837              	    ldr     r6, [r0, #\memAyo-200]
 838              	    ldr     r1, [r0, #\memDyo-40]
 839              	    ldr     r7, [r0, #\memAyu-200]
 840              	    ldr     lr, [r0, #\memDyu-40]
 841              	    
 842              	    eors    r6, r6, r1
 843              	    eors    r7, r7, lr
 844              	
 845              	    @ Applying rotations of the Rho step to the half-lanes of share 2
 846              	    .if  \rotAye > 0
 847              	        rors    r4, #32-\rotAye
 848              	    .endif
 849              	    rors    r5, #32-\rotAyi
 850              	    rors    r6, #32-\rotAyo
 851              	    rors    r7, #32-\rotAyu
 852              	
 853              	
 854              	
 855              	
 856              	    @PI+CHI APPLIED TO SHARE 1 (SHARES 2 - 0)
 857              	    @At this point, the register values are:
 858              	    @   - r3-r7: half-lanes of the share 0 with Theta and Rho steps applied (Group A)
 859              	    @   - r8-r12: half-lanes of the share 2 with Theta and Rho steps applied (Group B)
 860              	    @The following expansions of OpChi macro computes the output share Y_1 from input shares
 861              	    @X_2, X_0 and write them in the corresponding memory address according to in-place processing
 862              	    @(it will be one of the other positions in the diagonal, but not the same)
 863              	    @If we read from memory zone A, we write in the corresponding memory zone B. Else, we have read
 864              	
 865              	    push {r1, r2}
 866              	    .if     \memAya < 599
 867              	        OpChi   #\memAya+600, r4, r5, r8, r9, r10
 868              	        OpChi   #\memAye+600, r5, r6, r9, r10, r11
 869              	        OpChi   #\memAyi+600, r6, r7, r10, r11, r12
 870              	        OpChi   #\memAyo+600, r7, r3, r11, r12, r8
 871              	        OpChi   #\memAyu+600, r3, r4, r12, r8, r9
 872              	    .else 
 873              	        OpChi   #\memAya-600, r4, r5, r8, r9, r10
 874              	        OpChi   #\memAye-600, r5, r6, r9, r10, r11
 875              	        OpChi   #\memAyi-600, r6, r7, r10, r11, r12
 876              	        OpChi   #\memAyo-600, r7, r3, r11, r12, r8
 877              	        OpChi   #\memAyu-600, r3, r4, r12, r8, r9
 878              	    .endif
 879              	    pop {r1, r2}
 880              	
 881              	
 882              	
 883              	    @PI+CHI APPLIED TO SHARE 2 (SHARES 0 - 1).
 884              	    @Loading the half-lanes of share 1 (Theta+Rho already applied) into the group B of registers
 885              	
 886              	    ldr     r8, [r0, #\memAya]
 887              	    ldr     r9, [r0, #\memAye]
 888              	    ldr     r10, [r0, #\memAyi]
 889              	    ldr     r11, [r0, #\memAyo]
 890              	    ldr     r12, [r0, #\memAyu]
 891              	
 892              	    @If we read from memory zone A, we write in the corresponding memory zone B. Else, we have read
 893              	    
 894              	    push {r1, r2}
 895              	    .if     \memAya < 599
 896              	        OpChi   #\memAye+800, r10, r11, r4, r5, r6
 897              	        OpChi   #\memAyi+800, r11, r12, r5, r6, r7
 898              	        OpChi   #\memAyo+800, r12, r8, r6, r7, r3
 899              	        OpChi   #\memAyu+800, r8, r9, r7, r3, r4
 900              	    .else 
 901              	        OpChi   #\memAye-400, r10, r11, r4, r5, r6
 902              	        OpChi   #\memAyi-400, r11, r12, r5, r6, r7
 903              	        OpChi   #\memAyo-400, r12, r8, r6, r7, r3
 904              	        OpChi   #\memAyu-400, r8, r9, r7, r3, r4
 905              	    .endif
 906              	    pop {r1, r2}
 907              	
 908              	    @Loading the address where the Round Constants table starts
 909              	    ldr     r1, [r0, #mRC]
 910              	
 911              	    @Chi step applied to lane (0,0)
 912              	    eors r6, r3, r5
 913              	    and r7, r4, r5
 914              	    eors r6, r6, r7
 915              	    and r7, r4, r10
 916              	    eors r6, r6, r7
 917              	    and r7, r9, r5
 918              	    eors r6, r6, r7  
 919              	
 920              	    @Loading the Round Constant of Iota step applying the input offset to the memory address where 
 921              	    ldr     r4, [r1, #\offset]
 922              	
 923              	    @Lane(0,0) XOR RoundConstant 
 924              	    eors r6, r6, r4
 925              	
 926              	    .if  \last == 1
 927              	    ldr     r4, [r1, #32]!
 928              	    str     r1, [r0, #mRC]
 929              	    cmp     r4, #0xFF
 930              	    .endif
 931              	
 932              	    @Writing-back the lane (0,0) after applying Iota step in the writing memory zone
 933              	    .if     \memAya <599
 934              	        str     r6, [r0, #\memAya+800]
 935              	    .else
 936              	        str     r6, [r0, #\memAya-400]
 937              	    .endif
 938              	
 939              	
 940              	    pop {r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, r11, r12, lr}
 941              	.endm
 942              	
 943              	
 944              	
