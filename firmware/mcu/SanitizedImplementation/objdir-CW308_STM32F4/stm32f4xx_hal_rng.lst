 100:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c **** /** @addtogroup RNG_Exported_Functions_Group1
 101:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****  *  @brief   Initialization and de-initialization functions
 102:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****  *
 103:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c **** @verbatim
 104:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****  ===============================================================================
 105:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****           ##### Initialization and de-initialization functions #####
 106:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****  ===============================================================================
 107:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****     [..]  This section provides functions allowing to:
 108:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****       (+) Initialize the RNG according to the specified parameters 
 109:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****           in the RNG_InitTypeDef and create the associated handle
 110:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****       (+) DeInitialize the RNG peripheral
 111:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****       (+) Initialize the RNG MSP
 112:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****       (+) DeInitialize RNG MSP 
 113:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c **** 
 114:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c **** @endverbatim
 115:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   * @{
 116:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   */
 117:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   
 118:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c **** /**
 119:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   * @brief  Initializes the RNG peripheral and creates the associated handle.
 120:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   * @param  hrng: pointer to a RNG_HandleTypeDef structure that contains
 121:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   *                the configuration information for RNG.
 122:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   * @retval HAL status
 123:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   */
 124:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c **** HAL_StatusTypeDef HAL_RNG_Init(RNG_HandleTypeDef *hrng)
 125:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c **** { 
 126:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   /* Check the RNG handle allocation */
 127:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   if(hrng == NULL)
 128:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   {
 129:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****     return HAL_ERROR;
 130:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   }
 131:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   
 132:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   __HAL_LOCK(hrng);
 133:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   
 134:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   if(hrng->State == HAL_RNG_STATE_RESET)
 135:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   {  
 136:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****     /* Allocate lock resource and initialize it */
 137:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****     hrng->Lock = HAL_UNLOCKED;
 138:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****     /* Init the low level hardware */
 139:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****     HAL_RNG_MspInit(hrng);
 140:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   }
 141:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   
 142:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   /* Change RNG peripheral state */
 143:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   hrng->State = HAL_RNG_STATE_BUSY;
 144:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c **** 
 145:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   /* Enable the RNG Peripheral */
 146:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   __HAL_RNG_ENABLE(hrng);
 147:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c **** 
 148:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   /* Initialize the RNG state */
 149:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   hrng->State = HAL_RNG_STATE_READY;
 150:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   
 151:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   __HAL_UNLOCK(hrng);
 152:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   
 153:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   /* Return function status */
 154:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   return HAL_OK;
 155:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c **** }
 156:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c **** 
 157:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c **** /**
 158:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   * @brief  DeInitializes the RNG peripheral. 
 159:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   * @param  hrng: pointer to a RNG_HandleTypeDef structure that contains
