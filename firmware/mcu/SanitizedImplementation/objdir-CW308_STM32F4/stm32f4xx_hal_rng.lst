 333:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c **** /**
 334:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   * @brief  Handles RNG interrupt request.
 335:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   * @note   In the case of a clock error, the RNG is no more able to generate 
 336:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   *         random numbers because the PLL48CLK clock is not correct. User has 
 337:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   *         to check that the clock controller is correctly configured to provide
 338:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   *         the RNG clock and clear the CEIS bit using __HAL_RNG_CLEAR_IT(). 
 339:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   *         The clock error has no impact on the previously generated 
 340:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   *         random numbers, and the RNG_DR register contents can be used.
 341:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   * @note   In the case of a seed error, the generation of random numbers is 
 342:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   *         interrupted as long as the SECS bit is '1'. If a number is 
 343:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   *         available in the RNG_DR register, it must not be used because it may 
 344:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   *         not have enough entropy. In this case, it is recommended to clear the 
 345:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   *         SEIS bit using __HAL_RNG_CLEAR_IT(), then disable and enable 
 346:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   *         the RNG peripheral to reinitialize and restart the RNG.
 347:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   * @note   User-written HAL_RNG_ErrorCallback() API is called once whether SEIS
 348:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   *         or CEIS are set.  
 349:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   * @param  hrng: pointer to a RNG_HandleTypeDef structure that contains
 350:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   *                the configuration information for RNG.
 351:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   * @retval None
 352:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c **** 
 353:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   */
 354:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c **** void HAL_RNG_IRQHandler(RNG_HandleTypeDef *hrng)
 355:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c **** {
 356:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   /* RNG clock error interrupt occurred */
 357:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   if((__HAL_RNG_GET_IT(hrng, RNG_IT_CEI) != RESET) ||  (__HAL_RNG_GET_IT(hrng, RNG_IT_SEI) != RESET
 358:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   { 
 359:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****     /* Change RNG peripheral state */
 360:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****     hrng->State = HAL_RNG_STATE_ERROR;
 361:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   
 362:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****     HAL_RNG_ErrorCallback(hrng);
 363:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****     
 364:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****     /* Clear the clock error flag */
 365:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****     __HAL_RNG_CLEAR_IT(hrng, RNG_IT_CEI|RNG_IT_SEI);
 366:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****     
 367:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   }
 368:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   
 369:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   /* Check RNG data ready interrupt occurred */    
 370:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   if(__HAL_RNG_GET_IT(hrng, RNG_IT_DRDY) != RESET)
 371:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   {
 372:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****     /* Generate random number once, so disable the IT */
 373:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****     __HAL_RNG_DISABLE_IT(hrng);
 374:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****     
 375:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****     /* Get the 32bit Random number (DRDY flag automatically cleared) */ 
 376:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****     hrng->RandomNumber = hrng->Instance->DR;
 377:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****     
 378:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****     if(hrng->State != HAL_RNG_STATE_ERROR)
 379:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****     {
 380:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****       /* Change RNG peripheral state */
 381:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****       hrng->State = HAL_RNG_STATE_READY; 
 382:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****       
 383:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****       /* Data Ready callback */ 
 384:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****       HAL_RNG_ReadyDataCallback(hrng, hrng->RandomNumber);
 385:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****     } 
 386:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c ****   }
 387:../.././hal/chipwhisperer-fw-extra/stm32f4/stm32f4xx_hal_rng.c **** } 
